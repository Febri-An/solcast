# Solana devnet JSON-RPC (Alchemy or https://api.devnet.solana.com)
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/eUz961WPRvoY8TQXCRjMUztnOoWTLtwp
# Anchor CLI / local scripts — keep in sync with NEXT_PUBLIC_SOLANA_RPC_URL
ANCHOR_PROVIDER_URL=https://solana-devnet.g.alchemy.com/v2/eUz961WPRvoY8TQXCRjMUztnOoWTLtwp

# Supabase (create project at https://supabase.com — run supabase/migrations/001_profiles_and_storage.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by API routes for profile upserts and storage uploads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- On-chain data cache (optional; reduces browser → Solana RPC load) ---
# Run these migrations in Supabase before first use:
#   supabase/migrations/002_markets_cache.sql
#   supabase/migrations/003_positions_cache.sql
#
# Bootstrap happens automatically on first GET. To refresh manually/periodically:
#   npm run markets:sync              # local CLI
#   curl -X POST https://<host>/api/markets/sync \
#        -H "Authorization: Bearer $MARKETS_SYNC_SECRET"
#
# For scheduled refresh (Vercel Cron / GitHub Actions / VPS cron / Supabase pg_cron):
# see docs/CRON.md for ready-to-paste examples.
#
# MARKETS_SYNC_SECRET protects POST /api/markets/sync. Generate any random string, e.g.:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to allow unauthenticated sync (fine for local dev only).
# MARKETS_SYNC_SECRET=

# --- Admin (market creator) ---
# Only this wallet can create markets. Must match the `ADMIN` pubkey hard-coded
# in anchor/programs/prediction_market/src/lib.rs — the on-chain program
# enforces this; the env var just hides the "New Market" button for everyone else.
NEXT_PUBLIC_ADMIN_WALLET=B3WBoPbb2a98NrqRXBEe4P49irNCH8PEA4xzKzaYhXXr
