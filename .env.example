# Supabase (create project at https://supabase.com — run supabase/migrations/001_profiles_and_storage.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by API routes for profile upserts and storage uploads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
