# ===== Keeper bot configuration =====
# Copy to keeper/.env and edit values.

# Solana RPC endpoint (devnet default).
# For production use a paid/private endpoint (Helius, Triton, QuickNode, etc.)
KEEPER_RPC_URL=https://api.devnet.solana.com

# Path to the keeper wallet keypair (JSON array of 64 numbers).
# Defaults to the Solana CLI default wallet.
# For production use a dedicated keypair funded with a small amount of SOL.
KEEPER_KEYPAIR_PATH=~/.config/solana/id.json

# Prediction market program ID (must match Anchor.toml / declare_id!).
KEEPER_PROGRAM_ID=DYy72hMhhyHvbPjy71pp4137U4FumNuzM6i3mLVU2MWk

# Minimum total pool size (YES + NO) in SOL. Markets with less liquidity
# than this are ignored to avoid paying resolve fees on spam markets.
KEEPER_MIN_LIQUIDITY_SOL=0.01

# Poll interval in milliseconds between scan cycles.
KEEPER_POLL_INTERVAL_MS=15000

# Max number of markets to attempt resolving per scan cycle.
# Acts as a safety throttle; remaining markets are picked up next cycle.
KEEPER_MAX_MARKETS_PER_CYCLE=5

# Set to "true" to enable verbose logging (per-market diagnostics).
KEEPER_VERBOSE=false

# ===== Embedded cache sync =====
# The keeper can also refresh Supabase markets_cache / positions_cache so we
# don't need a separate cron. Runs independently of the resolve loop.
#
# Credentials are read from project-root .env if not set here:
#   NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
# If those are missing the sync simply stays OFF — keeper keeps resolving.

# How often to full-sync the cache from RPC (ms). Default: 60 seconds.
KEEPER_CACHE_SYNC_INTERVAL_MS=60000

# Force sync OFF even when Supabase is configured (e.g. if you'd rather run
# cron from Vercel / GitHub Actions / pg_cron once deployed).
KEEPER_CACHE_SYNC_DISABLED=false
